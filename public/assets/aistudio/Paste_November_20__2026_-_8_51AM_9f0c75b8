            <!-- Legenda 9 Kecamatan -->
            <div id="legendSection" class="pt-1">
                <span class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Legenda Warna Kecamatan</span>
                <div id="kecamatanLegend" class="grid grid-cols-2 gap-1.5 text-xs">
