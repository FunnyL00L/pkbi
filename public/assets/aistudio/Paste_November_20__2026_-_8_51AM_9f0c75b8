        </div>

        <!-- Footer / Tombol Refresh Realtime -->
        <div class="p-3.5 border-t border-slate-100 bg-slate-50/90 rounded-b-2xl flex items-center justify-between gap-2">
            <button onclick="fetchRealtimeBoundaries(true)" id="refreshBtn" class="w-full py-2 px-3 bg-white hover:bg-blue-50 text-blue-700 border border-blue-200 font-semibold text-xs rounded-xl shadow-sm flex items-center justify-center gap-2 transition-all active:scale-[0.99]">
                <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
                <span>Muat Ulang Data Batas (Overpass OSM)</span>
            </button>
        </div>
    </aside>

    <!-- Notifikasi Toast / Message Box (Pengganti alert()) -->
    <div id="toastBox" class="fixed bottom-5 right-5 z-[1002] max-w-sm bg-slate-900 text-white px-4 py-3 rounded-xl shadow-2xl border border-slate-700 text-xs flex items-center gap-3 transform translate-y-24 opacity-0 transition-all duration-300 pointer-events-none">
        <i data-lucide="info" class="w-4 h-4 text-blue-400 shrink-0"></i>
        <span id="toastMessage">Pesan informasi</span>
    </div>

    <script>
        // Inisialisasi ikon Lucide
        lucide.createIcons();

        // =========================================================================
        // 1. KONFIGURASI WILAYAH & WARNA KECAMATAN DI KABUPATEN BULELENG
        // =========================================================================
        const BULELENG_CENTER = [-8.18, 115.02];
        const BULELENG_DEFAULT_BOUNDS = [
            [-8.39, 114.42], // Barat Daya (Gerokgak / Gilimanuk perbatasan)
            [-8.06, 115.46]  // Timur Laut (Tejakula perbatasan Karangasem)
        ];

        // Palet warna distingtif untuk 9 Kecamatan di Kabupaten Buleleng
        const KECAMATAN_COLORS = {
            "Gerokgak": "#ef4444",      // Merah
            "Seririt": "#f97316",       // Oranye
            "Busungbiu": "#eab308",     // Kuning Emas
            "Banjar": "#22c55e",        // Hijau
            "Sukasada": "#14b8a6",      // Teal
            "Buleleng": "#3b82f6",      // Biru Utama
            "Sawan": "#6366f1",         // Indigo
            "Kubutambahan": "#a855f7",  // Ungu
            "Tejakula": "#ec4899"       // Pink
        };

        // Endpoint Overpass API Publik (Gratis & Tanpa API Key) dengan fallback mirror
        const OVERPASS_ENDPOINTS = [
            "https://overpass-api.de/api/interpreter",
            "https://overpass.kumi.systems/api/interpreter",
            "https://maps.mail.ru/osm/tools/overpass/api/interpreter"
        ];

        // =========================================================================
        // 2. INISIALISASI PETA LEAFLET & BASEMAPS GRATIS
        // =========================================================================
        const map = L.map('map', {
            center: BULELENG_CENTER,
            zoom: 10,
            zoomControl: false,
            attributionControl: true
        });

        // Pindahkan kontrol zoom ke kanan bawah agar tidak menabrak sidebar
        L.control.zoom({ position: 'bottomright' }).addTo(map);
        L.control.scale({ position: 'bottomleft', imperial: false }).addTo(map);

        // Definisi Basemap Gratis
        const basemaps = {
            positron: L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; OpenStreetMap &copy; CARTO',
                subdomains: 'abcd',
                maxZoom: 19
            }),
            osm: L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors',
                maxZoom: 19
            }),
            satellite: L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                attribution: 'Tiles &copy; Esri &mdash; Source: Esri, Maxar, Earthstar Geographics',
                maxZoom: 18
            })
        };

        let currentBasemap = basemaps.positron.addTo(map);

        // =========================================================================
        // 3. STATE & LAYER GROUPS
        // =========================================================================
        const layerGroups = {
            masking: L.layerGroup().addTo(map),
            kabupaten: L.layerGroup().addTo(map),
            kecamatan: L.layerGroup().addTo(map),
            desa: L.layerGroup().addTo(map),
            labels: L.layerGroup().addTo(map)
        };

        let appData = {
            kabupatenGeoJSON: null,
            kecamatanFeatures: [],
            desaFeatures: [],
            selectedKecamatan: 'ALL',
            desaLayersMap: new Map(),      // Menyimpan referensi L.Layer berdasarkan ID untuk pencarian/klik
            kecamatanLayersMap: new Map()
        };

        // Render Legenda Kecamatan di Sidebar
        function renderLegend() {
            const container = document.getElementById('kecamatanLegend');
            container.innerHTML = Object.entries(KECAMATAN_COLORS).map(([name, color]) => `
                <button onclick="document.getElementById('kecamatanSelect').value='${name}'; filterByKecamatan('${name}')" 
                    class="flex items-center gap-2 p-1.5 rounded-lg hover:bg-slate-100 text-left transition-colors">
                    <span class="w-3 h-3 rounded-full shrink-0 shadow-sm" style="background-color: ${color}"></span>
                    <span class="text-slate-700 font-medium truncate">${name}</span>
                </button>
            `).join('');
        }
        renderLegend();

        // =========================================================================
        // 4. PENGAMBILAN DATA BATAS GEOGRAFIS REALTIME DARI OVERPASS OSM API
        // =========================================================================
        /**
         * Query Overpass QL:
         * Mengambil batas Kabupaten Buleleng (admin_level=5),
         * seluruh Kecamatan di dalamnya (admin_level=6),
         * dan seluruh Desa/Kelurahan di dalamnya (admin_level=7).
         */
        function buildOverpassQuery() {
            return `
                [out:json][timeout:45];
                // Cari relasi administratif Kabupaten Buleleng
                relation["boundary"="administrative"]["admin_level"="5"]["name"~"Buleleng",i]->.kab;
                .kab map_to_area->.area_buleleng;
                (
                  // 1. Batas Kabupaten Buleleng
                  relation.kab;
                  // 2. Batas Kecamatan di dalam Buleleng (admin_level 6)
                  relation(area.area_buleleng)["boundary"="administrative"]["admin_level"="6"];
                  // 3. Batas Desa/Kelurahan di dalam Buleleng (admin_level 7)
                  relation(area.area_buleleng)["boundary"="administrative"]["admin_level"="7"];
                );
                out geom;
            `;
        }

        async function fetchWithFallbackOverpass(query) {
            let lastError = null;
            for (const endpoint of OVERPASS_ENDPOINTS) {
                try {
                    const controller = new AbortController();
                    const timeoutId = setTimeout(() => controller.abort(), 35000);
                    
                    const response = await fetch(endpoint, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                        },
                        body: 'data=' + encodeURIComponent(query),
                        signal: controller.signal
                    });
                    
                    clearTimeout(timeoutId);
                    if (!response.ok) throw new Error(`HTTP ${response.status}`);
                    const data = await response.json();
                    if (data && data.elements && data.elements.length > 0) {
                        return data;
                    }
                } catch (err) {
                    console.warn(`Endpoint ${endpoint} gagal:`, err);
                    lastError = err;
                }
            }
            throw lastError || new Error("Semua server Overpass API sibuk.");
        }

        // Fallback kedua jika Overpass API mengalami rate-limit ekstrem:
        // Mengambil data dari repositori GeoJSON terbuka / Nominatim
        async function fetchFallbackGeoJSON() {
            updateStatus(true, "Mengambil dari cadangan GeoJSON Indonesia...");
            // Bounding box Kabupaten Buleleng untuk Overpass BBox query ringan
            const bboxQuery = `
                [out:json][timeout:30];
                (
                  relation["boundary"="administrative"]["admin_level"~"5|6|7"](-8.40,114.42,-8.05,115.46);
                );
                out geom;
            `;
            return await fetchWithFallbackOverpass(bboxQuery);
        }

        async function fetchRealtimeBoundaries(forceRefresh = false) {
            const refreshBtn = document.getElementById('refreshBtn');
            refreshBtn.disabled = true;
            refreshBtn.classList.add('opacity-60');

            try {
                updateStatus(true, "Menarik batas geografis Buleleng (Overpass OSM)...");
                
                let osmData;
                try {
                    osmData = await fetchWithFallbackOverpass(buildOverpassQuery());
                } catch (e) {
                    osmData = await fetchFallbackGeoJSON();
                }

                updateStatus(true, "Memproses poligon Kecamatan & Desa...");

                // Konversi data mentah OSM menjadi standar GeoJSON menggunakan osmtogeojson
                const geojson = osmtogeojson(osmData);
                
                processAndRenderGeoJSON(geojson);

                const totalDesa = appData.desaFeatures.length;
                const totalKec = appData.kecamatanFeatures.length;
                document.getElementById('statsCounter').textContent = `${totalKec} Kec • ${totalDesa} Desa`;
                
                updateStatus(false, `Realtime OSM Aktif (${totalKec} Kec, ${totalDesa} Desa)`);
                if (forceRefresh) {
                    showToast(`Berhasil memperbarui ${totalKec} Kecamatan & ${totalDesa} Desa dari OpenStreetMap.`);
                }
            } catch (error) {
                console.error("Gagal memuat batas geografis:", error);
                updateStatus(false, "Gagal terhubung ke server OSM", true);
                showToast("Server Overpass OSM sedang sibuk. Silakan klik 'Muat Ulang Data Batas' beberapa saat lagi.");
                map.fitBounds(BULELENG_DEFAULT_BOUNDS);
            } finally {
                refreshBtn.disabled = false;
                refreshBtn.classList.remove('opacity-60');
            }
        }

        // =========================================================================
        // 5. PEMROSESAN POLIGON, SPATIAL JOIN KECAMATAN-DESA & MASKING
        // =========================================================================
        function cleanAdminName(name) {
            if (!name) return "Tanpa Nama";
            return name
                .replace(/^Kecamatan\s+/i, '')
                .replace(/^Kabupaten\s+/i, '')
                .trim();
        }

        function processAndRenderGeoJSON(geojson) {
            // Bersihkan layer lama
            Object.values(layerGroups).forEach(group => group.clearLayers());
            appData.kabupatenGeoJSON = null;
            appData.kecamatanFeatures = [];
            appData.desaFeatures = [];
            appData.desaLayersMap.clear();
            appData.kecamatanLayersMap.clear();

            const validKecamatanNames = Object.keys(KECAMATAN_COLORS);

            // Pisahkan fitur berdasarkan admin_level
            geojson.features.forEach(feature => {
                if (!feature.geometry || (feature.geometry.type !== 'Polygon' && feature.geometry.type !== 'MultiPolygon')) {
                    return;
                }
                const props = feature.properties || {};
                const level = String(props.admin_level || '');
                const rawName = props.name || props['name:id'] || '';

                if (level === '5' && /buleleng/i.test(rawName)) {
                    appData.kabupatenGeoJSON = feature;
                } else if (level === '6') {
                    const cleanKec = cleanAdminName(rawName);
                    // Pastikan termasuk dalam 9 Kecamatan Kabupaten Buleleng
                    const matchedKec = validKecamatanNames.find(k => k.toLowerCase() === cleanKec.toLowerCase());
                    if (matchedKec) {
                        feature.properties._cleanName = matchedKec;
                        appData.kecamatanFeatures.push(feature);
                    }
                } else if (level === '7') {
                    feature.properties._cleanName = rawName;
                    appData.desaFeatures.push(feature);
                }
            });

            // Jika poligon Kabupaten tidak ikut terambil langsung, gabungkan 9 poligon Kecamatan
            if (!appData.kabupatenGeoJSON && appData.kecamatanFeatures.length > 0) {
                try {
                    let merged = appData.kecamatanFeatures[0];
                    for (let i = 1; i < appData.kecamatanFeatures.length; i++) {
                        merged = turf.union(merged, appData.kecamatanFeatures[i]);
                    }
                    appData.kabupatenGeoJSON = merged;
                } catch (e) {
                    console.warn("Gagal menggabungkan poligon kecamatan:", e);
                }
            }

            // Spatial Matching: Petakan setiap Desa ke Kecamatan induknya & filter desa luar Buleleng
            const filteredDesa = [];
            appData.desaFeatures.forEach(desa => {
                try {
                    const center = turf.pointOnFeature(desa);
                    
                    // Cek apakah titik tengah desa berada di dalam Kabupaten Buleleng
                    if (appData.kabupatenGeoJSON && !turf.booleanPointInPolygon(center, appData.kabupatenGeoJSON)) {
                        return; // Abaikan desa dari kabupaten tetangga (Jembrana/Tabanan/Bangli/Karangasem)
                    }

                    // Cari kecamatan induknya
                    let parentKec = "Buleleng";
                    for (const kec of appData.kecamatanFeatures) {
                        if (turf.booleanPointInPolygon(center, kec)) {
                            parentKec = kec.properties._cleanName;
                            break;
                        }
                    }
                    desa.properties._kecamatan = parentKec;
                    filteredDesa.push(desa);
                } catch (e) {
                    // Fallback jika geometri kompleks
                    desa.properties._kecamatan = "Buleleng";
                    filteredDesa.push(desa);
                }
            });

            appData.desaFeatures = filteredDesa;

            // Render seluruh layer ke peta
            renderMaskingLayer();
            renderKabupatenLayer();
            renderKecamatanLayer();
            renderDesaLayer();

            // Zoom otomatis pas ke wilayah Kabupaten Buleleng
            resetViewToBuleleng();
        }

        // Masking: Menggelapkan wilayah di luar Kabupaten Buleleng
        function renderMaskingLayer() {
            layerGroups.masking.clearLayers();
            if (!appData.kabupatenGeoJSON) return;

            try {
                // Poligon dunia luas sebagai latar belakang gelap
                const worldPoly = turf.polygon([[
                    [-180, -90], [180, -90], [180, 90], [-180, 90], [-180, -90]
                ]]);
                // Lubangi bagian Kabupaten Buleleng menggunakan turf.difference
                const maskPoly = turf.difference(worldPoly, appData.kabupatenGeoJSON);
                if (maskPoly) {
                    L.geoJSON(maskPoly, {
                        style: {
                            fillColor: '#0f172a',
                            fillOpacity: 0.45,
                            stroke: false,
                            interactive: false
                        }
                    }).addTo(layerGroups.masking);
                }
            } catch (e) {
                console.warn("Masking error:", e);
            }
        }

        // Render Garis Luar Kabupaten Buleleng
        function renderKabupatenLayer() {
            layerGroups.kabupaten.clearLayers();
            if (!appData.kabupatenGeoJSON) return;

            L.geoJSON(appData.kabupatenGeoJSON, {
                style: {
                    color: '#0f172a',
                    weight: 3.5,
                    opacity: 0.9,
                    fill: false,
                    interactive: false
                }
            }).addTo(layerGroups.kabupaten);
        }

        // Render 9 Batas Kecamatan + Label Nama Kecamatan
        function renderKecamatanLayer() {
            layerGroups.kecamatan.clearLayers();
            layerGroups.labels.clearLayers();

            appData.kecamatanFeatures.forEach(feature => {
                const kecName = feature.properties._cleanName;
                const color = KECAMATAN_COLORS[kecName] || '#3b82f6';
                const isSelected = appData.selectedKecamatan === 'ALL' || appData.selectedKecamatan === kecName;

                const layer = L.geoJSON(feature, {
                    style: {
                        color: color,
                        weight: 2.2,
                        opacity: isSelected ? 0.95 : 0.25,
                        fillColor: color,
                        fillOpacity: isSelected ? 0.16 : 0.03
                    },
                    onEachFeature: (feat, lyr) => {
                        // Jika layer desa dimatikan, kecamatan bisa diklik & di-hover
                        lyr.on({
                            mouseover: (e) => {
                                if (!document.getElementById('toggleDesa').checked) {
                                    e.target.setStyle({ fillOpacity: 0.35, weight: 3 });
                                }
                            },
                            mouseout: (e) => {
                                if (!document.getElementById('toggleDesa').checked) {
                                    e.target.setStyle({ fillOpacity: isSelected ? 0.16 : 0.03, weight: 2.2 });
                                }
                            },
                            click: (e) => {
                                if (!document.getElementById('toggleDesa').checked) {
                                    openAdminPopup(feat, 'Kecamatan', e.latlng);
                                }
                            }
                        });
                    }
                });

                layer.addTo(layerGroups.kecamatan);
                appData.kecamatanLayersMap.set(kecName, layer);

                // Tambahkan Label Nama Kecamatan di titik tengah poligon
                try {
                    const center = turf.pointOnFeature(feature);
                    const [lng, lat] = center.geometry.coordinates;
                    const labelMarker = L.tooltip({
                        permanent: true,
                        direction: 'center',
                        className: 'kecamatan-label'
                    })
                    .setContent(`KEC. ${kecName.toUpperCase()}`)
                    .setLatLng([lat, lng]);

                    if (isSelected && document.getElementById('toggleKecamatan').checked) {
                        labelMarker.addTo(layerGroups.labels);
                    }
                } catch (e) {}
            });
        }

        // Render Batas Desa / Kelurahan di dalam Kecamatan
        function renderDesaLayer() {
            layerGroups.desa.clearLayers();
            appData.desaLayersMap.clear();

            appData.desaFeatures.forEach((feature, idx) => {
                const desaName = feature.properties._cleanName || 'Desa/Kelurahan';
                const kecName = feature.properties._kecamatan || 'Buleleng';
                const baseColor = KECAMATAN_COLORS[kecName] || '#3b82f6';
                const isVisible = appData.selectedKecamatan === 'ALL' || appData.selectedKecamatan === kecName;

                if (!isVisible) return;

                const defaultStyle = {
                    color: '#334155',
                    weight: 1.1,
                    dashArray: '3, 3',
                    opacity: 0.75,
                    fillColor: baseColor,
                    fillOpacity: 0.08
                };

                const layer = L.geoJSON(feature, {
                    style: defaultStyle,
                    onEachFeature: (feat, lyr) => {
                        // Tooltip saat hover
                        lyr.bindTooltip(`
                            <div class="desa-tooltip">
                                <div class="text-xs font-bold text-slate-900">${desaName}</div>
                                <div class="text-[10px] text-slate-500">Kec. ${kecName}</div>
                            </div>
                        `, { sticky: true, direction: 'top', offset: [0, -8] });

                        // Event Hover & Klik
                        lyr.on({
                            mouseover: (e) => {
                                const target = e.target;
                                target.setStyle({
                                    weight: 2.5,
                                    color: '#0f172a',
                                    dashArray: '',
                                    fillColor: baseColor,
                                    fillOpacity: 0.38
                                });
                                if (!L.Browser.ie && !L.Browser.opera && !L.Browser.edge) {
                                    target.bringToFront();
                                }
                            },
                            mouseout: (e) => {
                                e.target.setStyle(defaultStyle);
                            },
                            click: (e) => {
                                L.DomEvent.stopPropagation(e);
                                openAdminPopup(feat, 'Desa / Kelurahan', e.latlng);
                            }
                        });
                    }
                });

                layer.addTo(layerGroups.desa);
                const osmId = feature.id || `desa-${idx}`;
                appData.desaLayersMap.set(osmId, { layer, feature });
            });
        }

        // =========================================================================
        // 6. POPUP INFORMASI DETAIL WILAYAH (SAAT POLIGON DIKLIK)
        // =========================================================================
        function openAdminPopup(feature, tipeWilayah, latlng) {
            const props = feature.properties || {};
            const namaWilayah = props._cleanName || props.name || 'Tidak Diketahui';
            const kecamatan = tipeWilayah === 'Kecamatan' ? namaWilayah : (props._kecamatan || 'Buleleng');
            const color = KECAMATAN_COLORS[kecamatan] || '#3b82f6';
            
            // Hitung luas wilayah perkiraan dalam km² menggunakan Turf.js
            let luasKm2 = '-';
            try {
                const areaSqMeters = turf.area(feature);
                luasKm2 = (areaSqMeters / 1_000_000).toFixed(2) + ' km²';
            } catch (e) {}

            // Hitung titik koordinat tengah
            let centerCoord = `${latlng.lat.toFixed(5)}, ${latlng.lng.toFixed(5)}`;
            try {
                const pt = turf.pointOnFeature(feature);
                centerCoord = `${pt.geometry.coordinates[1].toFixed(5)}, ${pt.geometry.coordinates[0].toFixed(5)}`;
            } catch (e) {}

            // Kode wilayah BPS / Kemendagri jika tersedia di tag OSM
            const kodeWilayah = props['ref:bps'] || props['kode_bps'] || props['ISO3166-2'] || props.id || feature.id || '-';
            const statusDesa = /kelurahan/i.test(namaWilayah) || props['place'] === 'suburb' ? 'Kelurahan' : 'Desa / Kelurahan';

            const popupHTML = `
                <div class="font-sans">
                    <div class="px-4 py-3 text-white" style="background-color: ${color}">
                        <span class="inline-block text-[10px] uppercase tracking-wider font-bold bg-black/20 px-2 py-0.5 rounded-full mb-1">
                            ${tipeWilayah === 'Kecamatan' ? 'Wilayah Kecamatan' : statusDesa}
                        </span>
                        <h3 class="font-bold text-base leading-snug">${namaWilayah}</h3>
                    </div>
                    <div class="p-3.5 bg-white space-y-2 text-xs text-slate-700">
                        <div class="flex justify-between border-b border-slate-100 pb-1.5">
                            <span class="text-slate-400">Kecamatan</span>
                            <span class="font-semibold text-slate-900">${kecamatan}</span>
                        </div>
                        <div class="flex justify-between border-b border-slate-100 pb-1.5">
                            <span class="text-slate-400">Kabupaten</span>
                            <span class="font-semibold text-slate-900">Buleleng</span>
                        </div>
                        <div class="flex justify-between border-b border-slate-100 pb-1.5">
                            <span class="text-slate-400">Provinsi</span>
                            <span class="font-semibold text-slate-900">Bali</span>
                        </div>
                        <div class="flex justify-between border-b border-slate-100 pb-1.5">
                            <span class="text-slate-400">Perkiraan Luas</span>
                            <span class="font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded">${luasKm2}</span>
                        </div>
                        <div class="flex justify-between border-b border-slate-100 pb-1.5">
                            <span class="text-slate-400">ID / Kode OSM</span>
                            <span class="font-mono text-[11px] text-slate-600">${kodeWilayah}</span>
                        </div>
                        <div class="flex justify-between pt-0.5">
                            <span class="text-slate-400">Titik Tengah</span>
                            <span class="font-mono text-[11px] text-slate-600">${centerCoord}</span>
                        </div>
                    </div>
                </div>
            `;

            L.popup({ maxWidth: 300 })
                .setLatLng(latlng)
                .setContent(popupHTML)
                .openOn(map);
        }

        // =========================================================================
        // 7. INTERAKSI UI: FILTER KECAMATAN, PENCARIAN, TOGGLE LAYER & BASEMAP
        // =========================================================================
        function filterByKecamatan(kecName) {
            appData.selectedKecamatan = kecName;
            renderKecamatanLayer();
            renderDesaLayer();

            if (kecName === 'ALL') {
                resetViewToBuleleng();
            } else {
                const targetLayer = appData.kecamatanLayersMap.get(kecName);
                if (targetLayer) {
                    map.fitBounds(targetLayer.getBounds(), { padding: [40, 40], maxZoom: 13 });
                    showToast(`Menampilkan wilayah Kecamatan ${kecName}`);
                }
            }
        }

        function handleSearch(query) {
            const resultsBox = document.getElementById('searchResults');
            const clearBtn = document.getElementById('clearSearchBtn');
            const trimmed = query.trim().toLowerCase();

            if (!trimmed) {
                resultsBox.classList.add('hidden');
                clearBtn.classList.add('hidden');
                return;
            }

            clearBtn.classList.remove('hidden');

            // Cari di daftar Kecamatan dan Desa
            const matches = [];

            appData.kecamatanFeatures.forEach(feat => {
                const name = feat.properties._cleanName;
                if (name.toLowerCase().includes(trimmed)) {
                    matches.push({ type: 'Kecamatan', name: `Kecamatan ${name}`, sub: 'Kabupaten Buleleng', kec: name, feature: feat });
                }
            });

            appData.desaFeatures.forEach(feat => {
                const name = feat.properties._cleanName;
                const kec = feat.properties._kecamatan;
                if (name.toLowerCase().includes(trimmed)) {
                    matches.push({ type: 'Desa', name: name, sub: `Kec. ${kec}`, kec: kec, feature: feat });
                }
            });

            if (matches.length === 0) {
                resultsBox.innerHTML = `<div class="p-3 text-xs text-slate-500 text-center">Wilayah "${query}" tidak ditemukan di Buleleng.</div>`;
            } else {
                resultsBox.innerHTML = matches.slice(0, 15).map((item, i) => `
                    <button onclick="selectSearchResult(${i})" class="w-full px-3 py-2 text-left hover:bg-blue-50 flex items-center justify-between transition-colors">
                        <div>
                            <div class="text-xs font-semibold text-slate-800">${item.name}</div>
                            <div class="text-[10px] text-slate-500">${item.sub}</div>
                        </div>
                        <span class="text-[10px] font-medium px-2 py-0.5 rounded-full ${item.type === 'Kecamatan' ? 'bg-indigo-100 text-indigo-700' : 'bg-emerald-100 text-emerald-700'}">
                            ${item.type}
                        </span>
                    </button>
                `).join('');
                // Simpan sementara hasil pencarian untuk diakses saat diklik
                window._currentSearchMatches = matches.slice(0, 15);
            }

            resultsBox.classList.remove('hidden');
        }

        function selectSearchResult(index) {
            const item = window._currentSearchMatches?.[index];
            if (!item) return;

            // Pastikan filter kecamatan sesuai agar desa terlihat
            if (appData.selectedKecamatan !== 'ALL' && appData.selectedKecamatan !== item.kec) {
                document.getElementById('kecamatanSelect').value = 'ALL';
                filterByKecamatan('ALL');
            }

            const tempLayer = L.geoJSON(item.feature);
            const bounds = tempLayer.getBounds();
            const center = bounds.getCenter();

            map.fitBounds(bounds, { padding: [60, 60], maxZoom: item.type === 'Kecamatan' ? 12 : 14 });
            openAdminPopup(item.feature, item.type === 'Kecamatan' ? 'Kecamatan' : 'Desa / Kelurahan', center);

            document.getElementById('searchResults').classList.add('hidden');
        }

        function clearSearch() {
            document.getElementById('searchInput').value = '';
            document.getElementById('searchResults').classList.add('hidden');
            document.getElementById('clearSearchBtn').classList.add('hidden');
        }

        function toggleLayer(layerName, isChecked) {
            if (isChecked) {
                map.addLayer(layerGroups[layerName]);
                if (layerName === 'kecamatan') map.addLayer(layerGroups.labels);
            } else {
                map.removeLayer(layerGroups[layerName]);
                if (layerName === 'kecamatan') map.removeLayer(layerGroups.labels);
            }
        }

        function changeBasemap(type) {
            if (currentBasemap) map.removeLayer(currentBasemap);
            currentBasemap = basemaps[type].addTo(map);

            // Update styling tombol basemap
            document.querySelectorAll('.basemap-btn').forEach(btn => {
                btn.classList.remove('border-2', 'border-blue-600', 'bg-blue-50/60', 'text-blue-700');
                btn.classList.add('border', 'border-slate-200', 'text-slate-700');
            });
            const activeBtn = document.getElementById(`btn-${type}`);
            activeBtn.classList.remove('border', 'border-slate-200', 'text-slate-700');
            activeBtn.classList.add('border-2', 'border-blue-600', 'bg-blue-50/60', 'text-blue-700');
        }

        function resetViewToBuleleng() {
            if (appData.kabupatenGeoJSON) {
                const bounds = L.geoJSON(appData.kabupatenGeoJSON).getBounds();
                map.fitBounds(bounds, { padding: [30, 30] });
            } else {
                map.fitBounds(BULELENG_DEFAULT_BOUNDS);
            }
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebarPanel');
            sidebar.classList.toggle('hidden');
        }

        function updateStatus(isLoading, text, isError = false) {
            const spinner = document.getElementById('statusSpinner');
            const dot = document.getElementById('statusDot');
            const statusText = document.getElementById('statusText');

            statusText.textContent = text;
            if (isLoading) {
                spinner.classList.remove('hidden');
                dot.classList.add('hidden');
            } else {
                spinner.classList.add('hidden');
                dot.classList.remove('hidden');
                dot.className = `w-2.5 h-2.5 rounded-full ${isError ? 'bg-rose-500' : 'bg-emerald-400'}`;
            }
        }

        let toastTimer = null;
        function showToast(msg) {
            const box = document.getElementById('toastBox');
            document.getElementById('toastMessage').textContent = msg;
            box.classList.remove('translate-y-24', 'opacity-0');
            
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                box.classList.add('translate-y-24', 'opacity-0');
            }, 4000);
        }

        // Tutup sidebar otomatis di layar mobile sangat kecil saat pertama kali dibuka agar peta terlihat luas
        if (window.innerWidth < 640) {
            document.getElementById('sidebarPanel').classList.add('hidden');
        }

        // Jalankan pengambilan data batas geografis Kabupaten Buleleng saat halaman dimuat
        window.addEventListener('DOMContentLoaded', () => {
            fetchRealtimeBoundaries();
        });
    </script>
