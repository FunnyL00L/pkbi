{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Registered administrator account authorized to manage ECCD PKBI Buleleng portal content.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "minLength": 5, "maxLength": 160 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt"]
    },
    "CmsIntegrationConfig": {
      "title": "CmsIntegrationConfig",
      "description": "Admin-managed optional Cloudinary media upload endpoint configuration stored in Firebase Firestore (no secrets stored).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "gasWebAppUrl": { "type": "string", "minLength": 0, "maxLength": 500 },
        "cloudinaryCloudName": { "type": "string", "minLength": 0, "maxLength": 120 },
        "cloudinaryUploadPreset": { "type": "string", "minLength": 0, "maxLength": 120 },
        "cloudinaryFolder": { "type": "string", "minLength": 0, "maxLength": 120 },
        "autoSyncGas": { "type": "boolean" },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedBy": { "type": "string", "minLength": 2, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "gasWebAppUrl", "cloudinaryCloudName", "cloudinaryUploadPreset",
        "cloudinaryFolder", "autoSyncGas", "authorUid", "updatedBy", "createdAt", "updatedAt"
      ]
    },
    "CmsVillage": {
      "title": "CmsVillage",
      "description": "Custom or updated village/kelurahan marker across Kabupaten Buleleng managed by Admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
